# Plataforma da loja: nenhuma | exemplo | nuvemshop
# "nenhuma" liga só a triagem por menu, sem consulta nem avisos de pedido.
LOJA_PLATAFORMA=nenhuma

# De quantos em quantos minutos buscar pedidos alterados na plataforma
SYNC_INTERVALO_MINUTOS=5

# --- Nuvemshop (só se LOJA_PLATAFORMA=nuvemshop) ---
NUVEMSHOP_STORE_ID=
NUVEMSHOP_TOKEN=
# Exigido pela API: nome do seu app e um e-mail de contato
NUVEMSHOP_USER_AGENT=Meu Bot (contato@minhaloja.com.br)
